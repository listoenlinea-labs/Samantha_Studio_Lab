# Ejemplo sin secretos: copiar a .env en Hostinger, NUNCA subir claves al repositorio.
NODE_ENV=production
PORT=3000
SITE_USER=
SITE_PASSWORD=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
FRONTEND_ORIGINS=

# RECORDATORIOS: APAGADOS hasta configurar todos los proveedores y el consentimiento.
REMINDERS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Debe existir y estar aprobada en Meta con 5 variables:
# {{1}} paciente, {{2}} fecha, {{3}} hora, {{4}} profesional, {{5}} dirección.
WHATSAPP_TEMPLATE_NAME=recordatorio_cita_dental
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
WHATSAPP_API_VERSION=v23.0
